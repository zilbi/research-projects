  "profile_rule": {
    "priority": [
      3,
      2,
      1,
      4
    ],
    "dominance_penalty": 0.25,
    "dual_threshold": 0.3151547505157929,
    "heat_profile_threshold": 0.18199961348190258,
    "cold_profile_threshold": 0.37429935505367584,
    "dual_score": "min(heat_index, cold_index)",
    "heat_profile_score": "heat_index - dominance_penalty * cold_index",
    "cold_profile_score": "cold_index - dominance_penalty * heat_index"
  },
  "borderline_margin": 0.05,
  "groups": {
    "1": {
      "name_en": "Predominantly cold-resilient"
    },
    "2": {
      "name_en": "Predominantly heat-resilient"
    },
    "3": {
      "name_en": "Increased resilience to heat and cold"
    },
    "4": {
      "name_en": "Reduced resilience to heat and cold"
    }
  },
  "decision_rule": {
    "3": "dual_score >= dual_threshold",
    "2": "not group 3 AND heat_profile_score >= heat_profile_threshold",
    "1": "not groups 3/2 AND cold_profile_score >= cold_profile_threshold",
    "4": "otherwise"
  },
  "validation": {
    "method": "5-fold stratified out-of-fold predictions",
    "folds": 5,
    "random_state": 42,
    "bootstrap_replicates_for_recall_ci": 2000,
    "primary_success_metric": "minimum per-group recall",
    "target": 0.8
  }
